# GenAI Security Toolkit — API Keys
# Copy this file to .env and fill in the keys for each provider you want to use.
# .env is in .gitignore and will never be committed.

# ── Cloud LLM Providers ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
TOGETHER_API_KEY=...
PERPLEXITY_API_KEY=pplx-...
DEEPSEEK_API_KEY=sk-...
COHERE_API_KEY=...
HUGGINGFACE_API_KEY=hf_...

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# ── Local / Ollama ────────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434   # default; override if running elsewhere
