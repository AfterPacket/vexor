# GenAI Security Toolkit — API Keys
# Copy this file to .env and fill in the keys for each provider you want to use.
# .env is in .gitignore and will never be committed.

# ── Cloud LLM Providers ───────────────────────────────────────────────────────
# Uncomment only the providers you actually configure. Do not leave placeholder
# values active: main.py loads .env with override=True, so placeholders would
# override correctly set session/system environment variables.
# OPENAI_API_KEY=replace_with_your_key
# ANTHROPIC_API_KEY=replace_with_your_key
# GOOGLE_API_KEY=replace_with_your_key
# GROQ_API_KEY=replace_with_your_key
# MISTRAL_API_KEY=replace_with_your_key
# TOGETHER_API_KEY=replace_with_your_key
# PERPLEXITY_API_KEY=replace_with_your_key
# DEEPSEEK_API_KEY=replace_with_your_key
# COHERE_API_KEY=replace_with_your_key
# HUGGINGFACE_API_KEY=replace_with_your_key

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# ── Local / Ollama ────────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434   # default; override if running elsewhere
