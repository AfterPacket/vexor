# ── Security-sensitive (local testing only) ──────────────────────────────────
# Keep test payloads out of version control
test_payloads.json
malicious_prompts.txt
jailbreak_vectors.txt
exploit_code.py
bypass_techniques.md

# Scan cache and intermediate files
.scan_cache/
cache/
tmp/

# ── Exception: Keep these important files ────────────────────────────────────
!requirements.txt
!setup.py
!README.md
!CLAUDE.md
!.gitkeep
