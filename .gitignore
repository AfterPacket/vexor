# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# Never commit real API keys, even if misnamed
*api_key*
*secret_key*
*credentials*
*.pem
*.key
*.p12
*.pfx
*.crt

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Runtime data (generated, not source) ─────────────────────────────────────
# Scan reports — HTML and timestamped JSON outputs
reports/*.json
reports/*.html
# Failure store — persistent learning data (may contain probe prompts)
exploits/failure_store.json
# Keep effective_prompts.json (this is curated attack content, worth versioning)
# exploits/effective_prompts.json  ← intentionally NOT ignored

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Node (if any frontend tooling is added) ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Runtime data / scan results ────────────────────────────────────────────────
data/

# ── AI tool configs ───────────────────────────────────────────────────────────
.claude/

