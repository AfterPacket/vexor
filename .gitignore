# ── Vexor Local Testing & Payloads ──────────────────────────────────────────

# Local test files and experimental payloads
/tests/payloads/
/tests/local/
/tests/results/
/exploit_cache/
/local_tests/
/scratch/

# External payload files (referenced, not embedded)
*.payload
*.jailbreak
*.exploit
*.bypass
payloads/
jailbreaks/
# Runtime-generated learning data (recreated on demand by the app).
# The exploits/ source dir itself is kept; only its generated JSON is ignored.
exploits/*.json

# Model test results, persisted scans, reports, and logs — may contain prompts,
# model responses, account metadata, and real target/database information.
/scan_results/
/test_runs/
/results/
/data/scans/
/reports/
*.test.json
*.test.log
results_*.txt
scan_*.json
*_scan.json
*_scan.jsonl

# API keys, credentials, and personal/local configuration (NEVER commit)
.env
.env.*
!.env.example
!.env.template
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.secret
*.token
credentials.json
api_keys.json
secrets.yaml
secrets.yml
secrets.json
service-account*.json
service_account*.json
*-credentials.json
*credentials*.json
*api_key*.json
*apikey*.json
config.local.*
settings.local.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace

